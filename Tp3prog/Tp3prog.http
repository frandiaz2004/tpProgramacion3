@host = http://localhost:5175
# Usá los IDs devueltos al crear cada registro.
@playerId = 1
@trainerId = 2
@studentId = 3
@teamId = 1
@courseId = 1
@activityId = 1
@email = REEMPLAZAR_POR_TU_EMAIL
@password = REEMPLAZAR_POR_TU_CLAVE
@token = PEGAR_TOKEN_DEL_LOGIN
@userId = REEMPLAZAR_POR_TU_ID
@updatedEmail = REEMPLAZAR_POR_TU_NUEVO_EMAIL
@newPassword = REEMPLAZAR_POR_TU_NUEVA_CLAVE

### Crear jugador
POST {{host}}/Players
Content-Type: application/json

{"name":"Lionel Perez","age":21,"dni":"40111222","number":10}

### Crear entrenador
POST {{host}}/Trainers
Content-Type: application/json

{"name":"Maria Gomez","age":35,"dni":"30123456"}

### Crear estudiante
POST {{host}}/Students
Content-Type: application/json

{"name":"Ana Lopez","age":20,"dni":"45123456","file":"A-001"}

### Crear equipo
POST {{host}}/Teams
Content-Type: application/json

{"name":"Los Halcones","category":"Primera","playerIds":[{{playerId}}]}

### Crear curso
POST {{host}}/Courses
Content-Type: application/json

{"name":"Programacion III","studentIds":[{{studentId}}]}

### Crear actividad (type: 0 Class, 1 Exam, 2 Assignment)
POST {{host}}/Activities
Content-Type: application/json

{"title":"Practica de API","description":"Crear endpoints CRUD","date":"2026-10-22T10:00:00","type":2}

### Asociar estudiante
PUT {{host}}/Courses/{{courseId}}/students/{{studentId}}

### Asociar actividad
PUT {{host}}/Courses/{{courseId}}/activities/{{activityId}}

### Asociar jugador
PUT {{host}}/Teams/{{teamId}}/players/{{playerId}}

### Asociar entrenador
PUT {{host}}/Teams/{{teamId}}/trainers/{{trainerId}}

### Consultar equipos con relaciones
GET {{host}}/Teams
Accept: application/json

### Consultar curso con relaciones
GET {{host}}/Courses/{{courseId}}
Accept: application/json

### Consultar jugadores
GET {{host}}/Players

### Consultar entrenadores
GET {{host}}/Trainers

### Consultar estudiantes
GET {{host}}/Students

### Consultar actividades
GET {{host}}/Activities

### Actualizar jugador
PUT {{host}}/Players/{{playerId}}
Content-Type: application/json

{"name":"Lionel Perez","age":22,"dni":"40111222","number":11}

### Tipo de actividad inválido
POST {{host}}/Activities
Content-Type: application/json

{"title":"Actividad invalida","description":"Tipo fuera del enum","type":99}

### Nombre y edad inválidos
POST {{host}}/Students
Content-Type: application/json

{"name":"A","age":0,"file":"A-002"}

### ID distinto al de la ruta
PUT {{host}}/Courses/{{courseId}}
Content-Type: application/json

{"id":9223372036854775807,"name":"Programacion III"}

### Recurso inexistente
GET {{host}}/Courses/9223372036854775807

### Quitar estudiante del curso (409 si es el último)
DELETE {{host}}/Courses/{{courseId}}/students/{{studentId}}

### Quitar actividad del curso sin borrarla
DELETE {{host}}/Courses/{{courseId}}/activities/{{activityId}}

### Quitar jugador del equipo (409 si es el último)
DELETE {{host}}/Teams/{{teamId}}/players/{{playerId}}

### Quitar entrenador del equipo
DELETE {{host}}/Teams/{{teamId}}/trainers/{{trainerId}}

### Borrar equipo antes de eliminar sus jugadores
DELETE {{host}}/Teams/{{teamId}}

### Borrar curso antes de eliminar sus alumnos
DELETE {{host}}/Courses/{{courseId}}

### Borrar jugador
DELETE {{host}}/Players/{{playerId}}

### Borrar entrenador
DELETE {{host}}/Trainers/{{trainerId}}

### Borrar estudiante
DELETE {{host}}/Students/{{studentId}}

### Borrar actividad
DELETE {{host}}/Activities/{{activityId}}

### Crear usuario con tus credenciales (201; email repetido: 409)
POST {{host}}/User
Content-Type: application/json

{"email":"{{email}}","password":"{{password}}"}

### Iniciar sesión (200); copiá token de la respuesta en @token.
POST {{host}}/User/login
Content-Type: application/json

{"email":"{{email}}","password":"{{password}}"}

### Consultar usuario autenticado (200)
GET {{host}}/User/me
Authorization: Bearer {{token}}

### Credenciales incorrectas (401; este usuario no debe existir)
POST {{host}}/User/login
Content-Type: application/json

{"email":"no-existe@example.invalid","password":"clave-incorrecta"}

### Sin token (401)
GET {{host}}/User/me

### Consultar tu cuenta por ID
GET {{host}}/User/{{userId}}
Authorization: Bearer {{token}}

### Cambiar tu email conservando la contraseña
PUT {{host}}/User/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"email":"{{updatedEmail}}","currentPassword":"{{password}}"}

### Cambiar tu contraseña
PUT {{host}}/User/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"email":"{{updatedEmail}}","currentPassword":"{{password}}","newPassword":"{{newPassword}}"}

### Eliminar tu cuenta después del cambio de contraseña
DELETE {{host}}/User/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"currentPassword":"{{newPassword}}"}
